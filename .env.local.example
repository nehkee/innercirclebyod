# ─── App ───────────────────────────────────────────────────────────────────────
# Public URL of the site — used for payment redirects and webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Clerk Auth ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
# Clerk dashboard → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk (user.created/updated/deleted)
CLERK_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ─── Payments ──────────────────────────────────────────────────────────────────
# Each method appears at checkout only once its keys are set.

# Cards (USD) — Stripe dashboard → Developers → API keys.
# Webhook: https://<your-domain>/api/webhooks/stripe with events
#   checkout.session.completed, checkout.session.expired,
#   customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Paystack (NGN: card, bank transfer, USSD) — Paystack → Settings → API Keys & Webhooks.
# Webhook URL: https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Crypto (USDT/USDC/BTC) — NOWPayments dashboard.
# API key: Settings → API keys. IPN secret: Settings → Payments → Instant payment notifications.
# Choose accepted coins under "Coins settings" (e.g. USDTTRC20, USDTERC20, USDC, USDTSOL, USDCSOL, BTC).
# The IPN URL is sent automatically with each invoice: https://<your-domain>/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=xxxx
NOWPAYMENTS_IPN_SECRET=xxxx

# ─── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@innercirclebyod.com

# ─── Tickets ───────────────────────────────────────────────────────────────────
# Signs ticket QR codes. REQUIRED in production. Generate with: openssl rand -base64 32
TICKET_SECRET=change-me

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Admins are members with is_admin = TRUE in Supabase (see the end of supabase/schema.sql).

# ─── Placeholder content ───────────────────────────────────────────────────────
# Sample testimonials/leaderboard show in development only. Set to "true" to show
# them in production too (not recommended: they are not real members).
NEXT_PUBLIC_SHOW_PLACEHOLDER_CONTENT=false
